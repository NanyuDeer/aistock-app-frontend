VITE_API_BASE_URL=https://gupiao-api.yaozhineng.com/api
VITE_WS_BASE_URL=wss://gupiao-api.yaozhineng.com/ws
VITE_AGENT_WS_BASE=wss://gupiao-api.yaozhineng.com/api/agent/ws

# Vite 开发代理目标（仅 dev server proxy 使用，生产构建不生效）
VITE_PROXY_API_TARGET=http://localhost:56790
VITE_PROXY_AGENT_TARGET=http://localhost:8080
VITE_PROXY_WS_TARGET=ws://localhost:56790

# 微信 OAuth：AppID 见 src/manifest.json（公开标识）；AppSecret 由服务端持有，禁止写入前端仓库