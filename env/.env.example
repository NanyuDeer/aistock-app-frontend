# API 基础地址（App 运行时使用，H5 走 vite 代理用相对路径 /api）
VITE_API_BASE_URL=/api
# WebSocket 地址（Node.js 服务）
VITE_WS_BASE_URL=ws://localhost:3000/ws
# Agent Python 后端 WebSocket 地址（后端路由前缀 /api/agent + /ws/chat）
# 本地开发默认 8080；生产由 env/.env.production 注入 wss://gupiao-api.yaozhineng.com/api/agent/ws
VITE_AGENT_WS_BASE=ws://localhost:8080/api/agent/ws

# Vite 开发代理目标（仅 dev server proxy 使用，不影响构建产物）
VITE_PROXY_API_TARGET=http://localhost:3000
VITE_PROXY_AGENT_TARGET=http://localhost:8080
VITE_PROXY_WS_TARGET=ws://localhost:3000

# 微信 OAuth：AppID 见 src/manifest.json（公开标识，无需在此配置）
# AppSecret 属于服务端机密：由后端持有（如 app-api），禁止写入前端 env/manifest

# H5 微信网页授权（OAuth）登录用的 AppID（公开标识）：
# - 取测试号/正式服务号的 AppID；未配置时 H5"微信登录"自动降级为扫码登录
# - 必须与后端 app-api 的 WECHAT_APPID 一致，否则用 code 换 token 会失败
VITE_WECHAT_H5_APPID=

# App「分享到微信再授权」用的 H5 授权落地页地址（需为线上可访问的 H5 登录页，如
# https://<h5域名>/modules/user/pages/login）：
# - App 生成 state 后拼上 mode=app&state= 复制给用户，在微信中打开完成授权
# - 未配置/为空时，App"微信登录"直接降级为扫码登录，不会失效
VITE_H5_LOGIN_URL=
